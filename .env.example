# Copy to .env and fill in. .env is git-ignored — never commit real credentials.
# Only needed outside the "dev" profile (dev disables auth), or to use AuthUser's
# Auth0 user provisioning.

AUTH0_ISSUER_URI=https://YOUR_TENANT.us.auth0.com/
AUTH0_DOMAIN=https://YOUR_TENANT.us.auth0.com
AUTH0_AUDIENCE=https://mockbank/api

# PaymentOrchestrator -> AccountService machine-to-machine client (client_credentials)
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# AuthUser -> Auth0 Management API client
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
AUTH0_CUSTOMER_ROLE_ID=

# docker compose knobs
# POSTGRES_HOST_PORT=5433
# BATCHING_MAX_AGE=15s
# CENTRAL1_FAILURE_RATE=0     # 1 = every Central1 upload fails -> retries -> dead letter
# EFTNETWORK_FAILURE_RATE=0

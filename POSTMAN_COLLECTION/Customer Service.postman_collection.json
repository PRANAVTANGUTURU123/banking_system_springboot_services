{
  "info": {
    "_postman_id": "2732b024-6727-4673-bb14-8f9828d22566",
    "name": "Customer Service",
    "description": "Covers health, create (idempotent), get, patch (optimistic locking), KYC transitions, exists, and validation errors.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "36698671"
  },
  "item": [
    {
      "name": "01 — Create & Get (positive)",
      "item": [
        {
          "name": "Create (new → 201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Seed email/externalId/idempotency on first run",
                  "if (!pm.collectionVariables.get('email')) {",
                  "  pm.collectionVariables.set('email', pm.variables.replaceIn('user-{{$timestamp}}@example.com'));",
                  "}",
                  "if (!pm.collectionVariables.get('customerId')) {",
                  "  pm.collectionVariables.set('customerId', pm.variables.replaceIn('EXT-{{$timestamp}}-{{$randomInt}}'));",
                  "}",
                  "pm.collectionVariables.set('idemKey', pm.collectionVariables.get('customerId'));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status in [200,201]', ()=> { const ok=[200,201]; pm.expect(ok).to.include(pm.response.code); });",
                  "const json = pm.response.json();",
                  "pm.test('Has externalId', ()=> pm.expect(json.externalId).to.exist);",
                  "// capture ids & version",
                  "pm.collectionVariables.set('customerId', json.externalId);",
                  "pm.collectionVariables.set('internalId', String(json.id));",
                  "if (json.version !== undefined) pm.collectionVariables.set('version', String(json.version));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jim\",\n  \"lastName\": \"Doe\",\n  \"email\": \"jim@gmail.com\",\n  \"phone\": \"5474056993\",\n  \"address\": \"14 Figma St\",\n  \"externalId\": \"jim\"\n}"
            },
            "url": {
              "raw": "http://localhost:8083/api/v1/customers",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8083",
              "path": [

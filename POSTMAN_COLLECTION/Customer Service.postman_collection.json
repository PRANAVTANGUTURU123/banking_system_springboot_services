            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', ()=> pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Phone updated', ()=> pm.expect(json.phone).to.eql('+14165550000'));",
                  "if (json.version !== undefined) pm.collectionVariables.set('version', String(json.version));",
                  "pm.test('Version incremented', ()=> pm.expect(Number(pm.collectionVariables.get('version'))).to.be.greaterThan(Number(pm.collectionVariables.get('oldVersion'))));",
